{
    "swagger": "2.0",
    "info": {
        "title": "OpenVPN Client Zone API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/auth/logout": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Initiate logout",
                "operationId": "Logout",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/oauth/authorize": {
            "post": {
                "tags": [
                    "oauth"
                ],
                "summary": "Initiate OAuth2 authorization flow",
                "operationId": "StartOAuth",
                "parameters": [
                    {
                        "description": "OAuth2 authorization request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthAuthorizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthAuthorizeResponse"
                        }
                    }
                }
            }
        },
        "/oauth/callback": {
            "post": {
                "tags": [
                    "oauth"
                ],
                "summary": "Handle OAuth2 callback",
                "operationId": "FinishOAuth",
                "parameters": [
                    {
                        "description": "OAuth2 callback request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthCallbackRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content",
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthCallbackResponse"
                        }
                    }
                }
            }
        },
        "/servers": {
            "get": {
                "tags": [
                    "servers"
                ],
                "summary": "Get servers that the user has access to",
                "operationId": "GetUserServers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.Server"
                            }
                        }
                    }
                }
            }
        },
        "/servers/{serverId}/profile": {
            "get": {
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Download server profile",
                "operationId": "DownloadServerProfile",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "serverId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File stream",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "servers"
                ],
                "summary": "Update server profile",
                "operationId": "UpdateServerProfile",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "serverId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Profile data",
                        "name": "profile",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UpdateProfileRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Profile"
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "servers"
                ],
                "summary": "Delete server profile",
                "operationId": "DeleteServerProfile",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "serverId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/servers/{serverId}/profile/last-download": {
            "get": {
                "tags": [
                    "servers"
                ],
                "summary": "Get last profile download information",
                "operationId": "GetLastProfileDownload",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "serverId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.LastProfileDownloadResponse"
                        }
                    }
                }
            }
        },
        "/users/me": {
            "get": {
                "description": "Get the authenticated user's information.",
                "tags": [
                    "user"
                ],
                "summary": "Get authenticated user info",
                "operationId": "GetMe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.User"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.LastProfileDownloadResponse": {
            "type": "object",
            "required": [
                "exists"
            ],
            "properties": {
                "exists": {
                    "type": "boolean"
                },
                "last_downloaded_at": {
                    "type": "string"
                },
                "last_downloaded_hash": {
                    "type": "string"
                }
            }
        },
        "dto.OAuthAuthorizeRequest": {
            "type": "object",
            "required": [
                "redirect_uri"
            ],
            "properties": {
                "redirect_uri": {
                    "type": "string"
                }
            }
        },
        "dto.OAuthAuthorizeResponse": {
            "type": "object",
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "type": "string"
                }
            }
        },
        "dto.OAuthCallbackRequest": {
            "type": "object",
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "type": "string"
                }
            }
        },
        "dto.OAuthCallbackResponse": {
            "type": "object"
        },
        "dto.Profile": {
            "type": "object",
            "required": [
                "data",
                "hash",
                "updated_at"
            ],
            "properties": {
                "data": {
                    "type": "string"
                },
                "hash": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.Server": {
            "type": "object",
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "profile": {
                    "$ref": "#/definitions/dto.Profile"
                }
            }
        },
        "dto.UpdateProfileRequest": {
            "type": "object",
            "required": [
                "profile_data"
            ],
            "properties": {
                "profile_data": {
                    "type": "string"
                }
            }
        },
        "dto.User": {
            "type": "object",
            "required": [
                "email",
                "id",
                "is_admin",
                "name",
                "picture"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_admin": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "picture": {
                    "type": "string"
                }
            }
        }
    }
}